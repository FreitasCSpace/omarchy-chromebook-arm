# Kernel command line for depthcharge (omarchy-chromebook-kernel joins these lines
# after root=UUID=<the root filesystem>, which it works out itself).
rootwait rw rootflags=subvol=@
# Depthcharge hands over before the display is set up; keep the console on the panel.
console=tty1
# Verbose until boot is proven on the hardware; "quiet splash" brings the Plymouth splash back.
loglevel=7
